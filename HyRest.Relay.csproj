    <PackageReference Include="HyRest" Version="10.0.11" />
    <PackageReference Include="HyRest.DependencyInjection" Version="10.0.11" />
    <!--<PackageReference Include="HyRest" Version="10.0.4" />-->
    <!--<PackageReference Include="HyRest.DependencyInjection" Version="10.0.4" />-->
